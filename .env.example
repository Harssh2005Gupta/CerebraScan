# ==============================================================================
# NeuroMap — Environment Configuration Template
# Copy this file to '.env' for local configuration.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# Application Environment: 'development', 'testing', or 'production'
FLASK_ENV=development

# Server Secret Key (Generate a random 32+ character key for production)
NEUROMAP_SECRET_KEY=change-this-in-production-use-a-strong-random-key

# Path to trained Keras model artifact (.keras or .h5)
# If omitted or file not found, API responds with 503 and frontend indicates unreadiness
NEUROMAP_MODEL_PATH=model/best_model.keras

# Grad-CAM Convolutional Target Layer
# Set to 'auto' for dynamic recursive search of the deepest 4D conv layer
NEUROMAP_GRADCAM_LAYER=auto

# Storage directory for runtime Grad-CAM overlays (must be writable)
NEUROMAP_UPLOAD_DIR=static/gradcam

# Maximum upload payload size in bytes (16 MB = 16777216)
NEUROMAP_MAX_CONTENT_LENGTH=16777216

# Temporary file retention: Time-To-Live in seconds (3600 = 1 hour)
NEUROMAP_TEMP_TTL_SECONDS=3600

# Maximum number of heatmaps retained in upload folder before pruning
NEUROMAP_MAX_TEMP_FILES=500

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
NEUROMAP_LOG_LEVEL=INFO

# Server bind settings
HOST=0.0.0.0
PORT=5000
